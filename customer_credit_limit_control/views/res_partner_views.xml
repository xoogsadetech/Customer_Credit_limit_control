<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_property_form_credit_limit" model="ir.ui.view">
        <field name="name">res.partner.credit.limit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Credit Limit">
                    <field name="credit_limit"/>
                    <field name="credit_limit_policy"/>
                    <field name="credit_exposure" readonly="1"/>
                    <field name="credit_available" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
