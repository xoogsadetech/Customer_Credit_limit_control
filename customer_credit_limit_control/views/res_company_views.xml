<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_credit_limit" model="ir.ui.view">
        <field name="name">res.company.credit.limit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Credit Limit">
                    <group>
                        <field name="credit_limit_enforce"/>
                        <field name="credit_limit_include_uninvoiced_sales" attrs="{'invisible': [('credit_limit_enforce','=',False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
